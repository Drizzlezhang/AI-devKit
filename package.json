{
  "name": "@Drizzlezhang/ai-devkit",
  "version": "0.2.0",
  "description": "Intelligent Claude Code skill installer and spec-driven workflow toolkit with Trae CLI and Codex CLI runtime detection",
  "bin": {
    "ai-devkit": "bin/install.js",
    "ai-devkit-detect": "bin/detect.js"
  },
  "keywords": ["claude-code", "skill", "devkit", "spec-driven", "workflow"],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Drizzlezhang/AI-devKit.git"
  },
  "homepage": "https://github.com/Drizzlezhang/AI-devKit#readme",
  "bugs": {
    "url": "https://github.com/Drizzlezhang/AI-devKit/issues"
  },
  "author": "Drizzlezhang",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": ["bin/", "skills/", "templates/", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "check": "node ./bin/install.js --help && node ./bin/check-changelog.js",
    "detect": "node ./bin/detect.js",
    "render": "node ./bin/render-template.js",
    "smoke": "node ./bin/smoke.js",
    "pack:check": "npm pack --dry-run"
  }
}
